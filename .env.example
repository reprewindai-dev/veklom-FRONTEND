# ─── Veklom Control Plane – Environment Template ─────────────────────────────
# Configure deployment-specific values in the deployment secret/environment
# manager. Do not commit credentials, private topology, or concrete model hosts.

# Backend service URL used SERVER-SIDE by next.config.mjs rewrites.
# Prefer the authoritative internal service URL in deployment configuration.
BACKEND_URL=

# Required server-side cAPI/CAPPO execution endpoint and credential.
# cAPI remains the canonical Interlink/capability connection layer.
CAPI_BACKEND_URL=
CAPI_EXECUTION_PATH=/v1/exec
CAPI_API_KEY=

# Optional dependency health targets. Unconfigured services must be reported as
# NOT_VERIFIED / unavailable rather than synthesized as healthy.
GNOMLEDGER_URL=
LOCKERPHYCER_URL=http://127.0.0.1:8092
VLINK_URL=http://127.0.0.1:3000
ABIDE_URL=

# Public-facing API base. Leave empty when the deployment uses same-origin
# /api/* routing; set only when an authoritative public API base is required.
NEXT_PUBLIC_API_BASE_URL=

# Optional vector service integration. Keep topology and database credentials in
# the deployment environment, not in source examples.
VECTOR_SERVICE_URL=
VECTOR_DB_URL=

# Optional IDE/MCP mesh endpoint. No default is supplied because port 3000 is a
# forbidden foundation production/root fallback and mesh ownership is not
# established by this repository.
MCP_MESH_URL=

# Optional Ollama integration. Configure the deployment-specific host and model
# externally; do not commit concrete/private Ollama IPs or claimed inventories.
OLLAMA_URL=
OLLAMA_MODEL=

# ─── Veklom Wallet on Base (read at request time by /api/wallet/config) ───────
# base-sepolia (default, testnet) | base (mainnet). Set the same value on
# LockerPhycer (WALLET_NETWORK).
WALLET_NETWORK=base-sepolia
# CDP Portal project id (Create wallet by email, CDP Embedded Wallets). Also
# accepted as NEXT_PUBLIC_CDP_PROJECT_ID. Allow-list this site's origin in
# CDP Portal -> Wallets -> Embedded Wallet / Security.
CDP_PROJECT_ID=
# Reown (WalletConnect) Cloud project id for the all-wallets connect modal.
# Also accepted as NEXT_PUBLIC_REOWN_PROJECT_ID. Without it: Base Account +
# browser wallets only.
REOWN_PROJECT_ID=
# CDP Secret API key (server only) for Coinbase Onramp quotes. Onramp is used
# only when WALLET_NETWORK=base. Add this origin to the Onramp domain allowlist.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
ONRAMP_ENABLED=true
