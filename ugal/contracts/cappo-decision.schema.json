{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "phase": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "CONSTRAIN",
        "ESCALATE",
        "DEFER"
      ]
    },
    "receipt": {
      "type": "string"
    }
  }
}