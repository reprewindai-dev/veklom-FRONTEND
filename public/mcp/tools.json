      "auth_required": false,
      "status": "active",
      "limitations": ["Rate limited per IP"]
    },
    {
      "name": "read_claims",
      "description": "Reads the cryptographic claims registry.",
      "input_schema": {},
      "output_route": "/machine/claims.json",
      "auth_required": false,
      "status": "active",
      "limitations": ["Rate limited per IP"]
    },
    {
      "name": "read_conformance",
      "description": "Reads the protocol conformance matrix.",
      "input_schema": {},
      "output_route": "/machine/conformance.json",
      "auth_required": false,
      "status": "active",
      "limitations": ["Rate limited per IP"]
    },
    {
      "name": "read_evidence_index",
      "description": "Reads the index of settled cryptographic evidence.",
      "input_schema": {},
      "output_route": "/machine/evidence-index.json",
      "auth_required": false,
      "status": "active",
      "limitations": ["Rate limited per IP"]
    },
    {
      "name": "read_openapi",
      "description": "Reads the OpenAPI specification for the node.",
      "input_schema": {},
      "output_route": "/machine/openapi.json",
      "auth_required": false,
      "status": "active",
      "limitations": ["Rate limited per IP"]
    },
    {
      "name": "read_llms",
      "description": "Reads the standard llms.txt index.",
      "input_schema": {},
      "output_route": "/llms.txt",
      "auth_required": false,
      "status": "active",
      "limitations": ["Rate limited per IP"]
    },
    {
      "name": "read_llms_full",
      "description": "Reads the expanded llms-full.txt context.",
      "input_schema": {},
      "output_route": "/llms-full.txt",
      "auth_required": false,
      "status": "active",
      "limitations": ["Rate limited per IP"]
    },
    {
      "name": "run_governed_machine_demo",
      "description": "Executes the interactive governed machine demo.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": { "type": "string" }
        },
        "required": ["action"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "receipt_id": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "auth_required": true,
      "status": "active",
      "limitations": [
        "Requires valid Veklom session. Headless machine enrollment via Device Flow is in integration.",
        "Bounded by policy engine limits"
      ],
      "invocation_contract": {
        "authenticate": {
          "method": "POST",
          "route": "https://command.veklom.com/api/v1/auth/github/exchange",
          "auth": "None",
          "body": { "github_username": "machine_agent" },
          "description": "Exchange identity for execution bearer token."
        },
        "request_mount": {
          "method": "POST",
          "route": "https://veklom.com/api/cappo/v1/capability/mounts",
          "auth": { "type": "bearer" },
          "body": { "package_id": "core/governed-counter" },
          "description": "Request bounded capability mount. Returns mount_id."
        },
        "execute": {
          "method": "POST",
          "route": "https://veklom.com/api/cappo/v1/capability/mounts/{mount_id}/execute",
          "auth": { "type": "bearer" },
          "body": { "effect_id": "increment", "payload": { "amount": 1 } },
          "description": "Execute governed action on mount. Returns receipt."
        },
        "get_receipt": {
          "method": "GET",
          "route": "https://veklom.com/api/cappo/v1/capability/mounts/{mount_id}",
          "auth": { "type": "bearer" },
          "description": "Retrieve resulting state and evidence."
        },
        "revoke": {
          "method": "DELETE",
          "route": "https://veklom.com/api/cappo/v1/capability/mounts/{mount_id}",
          "auth": { "type": "bearer" },
          "description": "Revoke authority mount."
        }
      }
    }
  ]
}
